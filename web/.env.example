# NextAuth / Google sign-in
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 운영진 전용 관리자 페이지 (/admin). 쉼표로 여러 이메일을 넣을 수 있습니다.
# 예: ADMIN_EMAILS=voicewithai.admin@gmail.com
ADMIN_EMAILS=

# Discord account connection and bot invitation
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_INVITE_URL=

# 웹 DB: 계정, 프로필, 동의, 요금제, 크레딧
# 기존 DATABASE_URL을 쓰는 환경과 호환되지만, 배포에서는 WEB_DATABASE_URL을 권장합니다.
WEB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_anime_web
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_anime_web

# 봇 DB: 대화 기록, 장기기억, 서버/채널 음성 설정, 음성 세션
# 웹 DB와 반드시 다른 Neon 데이터베이스(현재 운영 기준 bot_db)를 넣습니다.
BOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_anime_bot
